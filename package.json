{
  "name": "rbx-dom",
  "version": "0.3.0",
  "description": "Node.js bindings for the rbx-dom Roblox DOM libraries",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "native/index.js",
    "native/index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "format": "cargo fmt --all",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "build": "napi build --platform --release --esm --dts index.d.ts --manifest-path native/Cargo.toml --output-dir native",
    "build:debug": "napi build --platform --esm --dts index.d.ts --manifest-path native/Cargo.toml --output-dir native",
    "artifacts": "napi artifacts --output-dir artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/**/*.test.js",
    "test:cargo": "cargo test --workspace",
    "test:examples": "npm run build:debug && node scripts/test-examples.js"
  },
  "napi": {
    "binaryName": "rbx-dom",
    "packageName": "@unrealworks/rbx-dom",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "optionalDependencies": {
    "@unrealworks/rbx-dom-linux-x64-gnu": "0.3.0",
    "@unrealworks/rbx-dom-linux-arm64-gnu": "0.3.0",
    "@unrealworks/rbx-dom-linux-x64-musl": "0.3.0",
    "@unrealworks/rbx-dom-linux-arm64-musl": "0.3.0",
    "@unrealworks/rbx-dom-win32-x64-msvc": "0.3.0",
    "@unrealworks/rbx-dom-win32-arm64-msvc": "0.3.0",
    "@unrealworks/rbx-dom-darwin-x64": "0.3.0",
    "@unrealworks/rbx-dom-darwin-arm64": "0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unreal-Works/rbx-dom-napi.git"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  }
}
